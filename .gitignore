# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual Environments
.venv/
venv/
env/
.venv_client/
Client/.venv_client/

# Pytest / Cache
.pytest_cache/
.coverage
htmlcov/

# Editor / IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# Runtime Data and Logs
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
Client/export/sent/*
!Client/export/sent/.gitkeep
Client/export/failed/*
!Client/export/failed/.gitkeep
*.sqlite3
*.db
.secret_key
*.pkg

# Secrets — private key ký license/bản vá và file license cấp cho từng khách hàng
keys/
*.pem
license.key

# Cấu hình thật của từng máy (mật khẩu, IP nội bộ, mã Client Agent) — mẫu dùng chung là config.default.yaml
config.yaml

# OS generated
.DS_Store
Thumbs.db

